# Copy to /etc/campushub/application.env, root:root 0600. Never commit real values.
# MySQL TLS certificate must match host; provision a Java truststore for private CA.
CH_PROD_DB_URL=jdbc:mysql://db.example.internal:3306/campushub_prod?sslMode=VERIFY_IDENTITY&characterEncoding=UTF-8&connectionTimeZone=UTC
CH_PROD_DB_NAME=campushub_prod
CH_PROD_DB_USERNAME=campushub_prod_app
CH_PROD_DB_ACCOUNT=campushub_prod_app@localhost
CH_PROD_DB_PASSWORD=REPLACE_WITH_UNIQUE_SECRET
CH_WECHAT_APP_ID=REPLACE_WITH_REAL_APPID
CH_WECHAT_APP_SECRET=REPLACE_WITH_SERVER_ONLY_SECRET
# Do not add FLYWAY_* or migrator/operator credentials here.
