button.activity-card:not([size='mini']) { display: block; width: 100%; text-align: left; padding: 28rpx; margin: 20rpx 0; border: 1px solid var(--ch-border); border-radius: var(--ch-radius); font-weight: 400; box-sizing: border-box; }
.card-top { display: flex; align-items: flex-start; gap: 24rpx; }
.date { background: var(--ch-tint); color: var(--ch-primary); width: 106rpx; min-width: 106rpx; padding: 12rpx 0; border-radius: 18rpx; text-align: center; }
.month { display: block; font-size: 11px; line-height: 20px; }
.day { display: block; font-size: 29px; font-weight: 750; line-height: 32px; }
.card-main { min-width: 0; flex: 1; }
.category { color: var(--ch-primary); font-size: 12px; margin-bottom: 4rpx; }
.title { font-size: 18px; font-weight: 700; line-height: 1.45; overflow-wrap: anywhere; }
.location { color: var(--ch-muted); font-size: 13px; overflow-wrap: anywhere; margin-top: 10rpx; }
.summary { color: var(--ch-muted); font-size: 14px; line-height: 1.6; margin: 24rpx 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.card-bottom { padding-top: 20rpx; border-top: 1px dashed var(--ch-border); display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx; font-size: 12px; color: var(--ch-muted); }
.status { color: var(--ch-primary); font-weight: 600; }
