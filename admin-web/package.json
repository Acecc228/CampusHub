{
  "name": "campushub-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src tests vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests vite.config.ts playwright.config.ts eslint.config.js package.json tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.14.7",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
