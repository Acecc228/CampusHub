<view class="page detail-page"><page-state state="{{state}}" message="{{error}}" bind:retry="load" bind:login="login"/>
<block wx:if="{{activity && state === 'ready'}}">
  <view class="badge">{{activity.categoryName}}</view><view class="heading">{{activity.title}}</view><view class="muted break">{{activity.summary}}</view>
  <view class="ticket panel"><view class="row"><view><view class="small">当前报名</view><view class="section-title {{activity.confirmed ? 'success' : ''}}">{{activity.confirmed ? '已报名 · 期待见面' : activity.availability.label}}</view></view><view class="seat"><text>{{activity.remainingCapacity}}</text><view class="small">剩余名额</view></view></view><view class="ticket-bottom">已报名 {{activity.registeredCount}} 人 / 共 {{activity.capacity}} 人</view></view>
  <view class="panel stack"><view class="section-title">活动安排</view><view><view class="small">活动地点</view><view class="break">{{activity.location}}</view></view><view><view class="small">活动时间 · 北京时间</view><view>{{activity.timeText}}</view><view class="muted">至 {{activity.endText}}</view></view><view><view class="small">报名时间 · 北京时间</view><view>{{activity.registrationStartText}}</view><view class="muted">至 {{activity.registrationEndText}}</view></view></view>
  <view class="panel"><view class="section-title">关于这场活动</view><view class="content break">{{activity.content}}</view></view>
  <view wx:if="{{feedback}}" class="panel" aria-live="polite">{{feedback}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="action-bar"><view class="action-inner"><button wx:if="{{uncertain}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="verify">核实报名状态</button><block wx:else><view class="small">{{activity.confirmed ? (activity.canCancel ? '活动开始前可取消' : '活动已开始，不能取消') : activity.availability.label}}</view><button class="{{activity.confirmed ? 'secondary' : 'primary'}}" loading="{{busy}}" disabled="{{busy || (activity.confirmed ? !activity.canCancel : !activity.availability.enabled)}}" bindtap="act" hover-class="pressed">{{busy ? '正在确认' : activity.confirmed ? '取消报名' : '立即报名'}}</button></block></view></view>
  <button class="ghost" bindtap="mine">查看我的报名 →</button>
</block></view>
