{
  "name": "campushub-miniprogram",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-static.cjs",
    "build": "tsc && node scripts/build.cjs",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:api": "node tests/real-api.cjs",
    "build:production": "node scripts/build-production.cjs"
  },
  "devDependencies": {
    "miniprogram-api-typings": "5.2.3",
    "miniprogram-automator": "0.13.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "minimist": "1.2.8",
    "jpeg-js": "0.4.4",
    "debug": "4.4.3"
  }
}
