@import './styles/tokens.wxss';
.page { padding: 28rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); max-width: 640px; margin: auto; }
.eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 3rpx; color: var(--ch-primary); }
.heading { font-size: 27px; font-weight: 750; line-height: 1.3; margin: 10rpx 0 16rpx; overflow-wrap: anywhere; white-space: pre-line; }
.section-title { font-size: 19px; font-weight: 700; }
.muted { color: var(--ch-muted); font-size: 14px; }
.small { font-size: 12px; color: var(--ch-muted); }
.panel { padding: 32rpx; background: var(--ch-surface); border: 1px solid var(--ch-border); border-radius: var(--ch-radius); margin: 24rpx 0; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.stack > view { margin-bottom: 16rpx; }
.section { margin-top: 42rpx; margin-bottom: 22rpx; }
button { margin: 0; padding: 10px 18px; min-height: var(--ch-touch); font-size: 15px; line-height: 24px; border-radius: 14px; font-weight: 600; background: var(--ch-surface); color: var(--ch-text); white-space: normal; }
button:not([size='mini']) { width: auto; margin: 0; }
button::after { border: 0; }
.primary { color: var(--ch-surface); background: var(--ch-primary); }
.secondary { color: var(--ch-primary); background: var(--ch-tint); }
.danger { color: var(--ch-danger); border: 1px solid var(--ch-border); }
.ghost { background: transparent; color: var(--ch-primary); padding: 10px 8px; }
button[disabled] { opacity: .55; color: var(--ch-muted); background: var(--ch-border); }
.pressed { opacity: .72; }
.error { color: var(--ch-danger); background: var(--ch-surface); border-left: 3px solid var(--ch-danger); padding: 12px; margin: 16px 0; font-size: 14px; overflow-wrap: anywhere; }
.badge { display: inline-block; color: var(--ch-primary); background: var(--ch-tint); padding: 4rpx 16rpx; border-radius: 99rpx; font-size: 12px; }
.success { color: var(--ch-success); }
.field { margin: 24rpx 0; }
.label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 12rpx; }
input { background: var(--ch-surface); border: 1px solid var(--ch-border); border-radius: 14px; min-height: 48px; padding: 0 14px; box-sizing: border-box; font-size: 16px; }
.break { word-break: break-all; white-space: pre-wrap; }
.footer-note { text-align: center; color: var(--ch-muted); font-size: 12px; padding: 28rpx 0; }
